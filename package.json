{
	"name": "obsidian-exo-agent",
	"version": "0.41.1",
	"packageManager": "pnpm@10.17.1",
	"description": "Exo Agent: an agentic AI assistant in your Obsidian sidebar, powered by the Claude or Codex CLI, with a custom theme-aware chat UI.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node scripts/contract.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"contract": "node scripts/contract.mjs",
		"release:check": "pnpm lint && pnpm lint:obsidian && pnpm test && pnpm build",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint src tests",
		"lint:obsidian": "eslint -c eslint.obsidian.config.mjs src",
		"test": "vitest run",
		"smoke": "node scripts/smoke.mjs",
		"bump": "node scripts/bump.mjs"
	},
	"keywords": [
		"obsidian",
		"claude",
		"codex",
		"ai",
		"agent"
	],
	"author": "Mario Miletta",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@types/node": "^22.0.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.62.1",
		"vitest": "^3.2.6"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.195",
		"zod": "^4.4.3"
	}
}
